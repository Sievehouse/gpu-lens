{
  "name": "gpu-lens-web",
  "version": "0.2.0",
  "private": true,
  "description": "GPU Lens Operator Console — TypeScript + TSX on a small built-in JSX runtime (no framework dependency)",
  "scripts": {
    "build": "node scripts/build_offline.js",
    "dev": "node scripts/build_offline.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/build_offline.js --verify-only"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}
