#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Test double for `amd-smi` used by the GPU Lens test suites. It is NOT an AMD tool: it prints canned,
# deterministic JSON for the four read-only invocations GPU Lens issues, so the AMD adapter can be exercised on
# machines without AMD hardware. The layouts follow AMD's documented amd-smi output (ROCm 6.x).
#
# Environment knobs:
#   FAKE_AMD_MODE    ok | no-devices | driver-fail                    (default ok)
#   FAKE_AMD_FORMAT  modern ({"value","unit"}) | legacy ("45 C") | wrapped ({"gpu_data": [...]})  (default modern)
#   FAKE_AMD_TEMP0   edge temperature of GPU 0 in C                    (default 45)
#   FAKE_AMD_UTIL0   graphics activity of GPU 0 in %                   (default 88)
MODE="${FAKE_AMD_MODE:-ok}"
FORMAT="${FAKE_AMD_FORMAT:-modern}"
TEMP0="${FAKE_AMD_TEMP0:-45}"
UTIL0="${FAKE_AMD_UTIL0:-88}"

if [ "$MODE" = "no-devices" ]; then
  echo "ERROR: No AMD GPUs found on this system" >&2
  exit 2
fi
if [ "$MODE" = "driver-fail" ]; then
  echo "ERROR: amdgpu driver not initialized" >&2
  exit 1
fi

v() { # value unit -> JSON fragment in the selected format
  if [ "$FORMAT" = "legacy" ]; then printf '"%s %s"' "$1" "$2"; else printf '{"value": %s, "unit": "%s"}' "$1" "$2"; fi
}
wrap_open() { if [ "$FORMAT" = "wrapped" ]; then printf '{"gpu_data": '; fi; }
wrap_close() { if [ "$FORMAT" = "wrapped" ]; then printf '}'; fi; echo; }

case "$1 $2" in
  "list --json")
    wrap_open
    printf '[{"gpu": 0, "bdf": "0000:0c:00.0", "uuid": "1fff74a1-0000-1000-80ff-2f9e47e3eb6c"}, {"gpu": 1, "bdf": "0000:22:00.0", "uuid": "8dff74a1-0000-1000-80c4-91d2a7a8b001"}]'
    wrap_close ;;
  "static --json")
    wrap_open
    for i in 0 1; do
      [ "$i" = 1 ] && printf ', ' || printf '['
      bdf="0000:0c:00.0"; [ "$i" = 1 ] && bdf="0000:22:00.0"
      printf '{"gpu": %s, "asic": {"market_name": "AMD Instinct MI300X", "vendor_name": "Advanced Micro Devices Inc. [AMD/ATI]", "asic_serial": "0x8A1B2C3D%s"}, "bus": {"bdf": "%s", "max_pcie_width": 16, "max_pcie_speed": %s}, "driver": {"name": "amdgpu", "version": "6.7.0"}, "limit": {"max_power": %s}}' \
        "$i" "$i" "$bdf" "$(v 32 GT/s)" "$(v 750 W)"
    done
    printf ']'; wrap_close ;;
  "metric --json")
    wrap_open
    printf '[{"gpu": 0, "usage": {"gfx_activity": %s, "umc_activity": %s}, "power": {"socket_power": %s, "throttle_status": "UNTHROTTLED"}, "temperature": {"edge": %s, "hotspot": %s, "mem": %s}, "ecc": {"total_correctable_count": 0, "total_uncorrectable_count": 0}, "fan": {"usage": "N/A"}, "pcie": {"width": 16, "speed": %s}, "mem_usage": {"total_vram": %s, "used_vram": %s, "free_vram": %s}}' \
      "$(v "$UTIL0" %)" "$(v 41 %)" "$(v 612 W)" "$(v "$TEMP0" C)" "$(v $((TEMP0 + 12)) C)" "$(v 58 C)" "$(v 32 GT/s)" "$(v 196592 MB)" "$(v 151000 MB)" "$(v 45592 MB)"
    # GPU 1: Instinct parts often report edge as N/A; the hotspot sensor is used instead.
    printf ', {"gpu": 1, "usage": {"gfx_activity": %s, "umc_activity": %s}, "power": {"socket_power": %s, "throttle_status": "UNTHROTTLED"}, "temperature": {"edge": "N/A", "hotspot": %s, "mem": %s}, "ecc": {"total_correctable_count": 3, "total_uncorrectable_count": 0}, "fan": {"usage": "N/A"}, "pcie": {"width": 16, "speed": %s}, "mem_usage": {"total_vram": %s, "used_vram": %s, "free_vram": %s}}]' \
      "$(v 3 %)" "$(v 0 %)" "$(v 141 W)" "$(v 39 C)" "$(v 36 C)" "$(v 32 GT/s)" "$(v 196592 MB)" "$(v 283 MB)" "$(v 196309 MB)"
    wrap_close ;;
  "process --json")
    wrap_open
    printf '[{"gpu": 0, "process_list": [{"process_info": {"name": "python3", "pid": 4242, "memory_usage": {"gtt_mem": %s, "cpu_mem": %s, "vram_mem": %s}}}]}, {"gpu": 1, "process_list": []}]' \
      "$(v 2097152 B)" "$(v 0 B)" "$(v 158334976000 B)"
    wrap_close ;;
  *)
    echo "fake-amd-smi: unsupported invocation: $*" >&2
    exit 64 ;;
esac
